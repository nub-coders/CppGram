# CppGram Git Ignore

# Build Directories & Artifacts
build/
build*/
bin/
lib/
out/
cmake-build-*/
_deps/

# Compiled Objects & Libraries
*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib
*.exe
*.out
*.app

# CMake Generated Files
CMakeCache.txt
CMakeFiles/
CMakeScripts/
