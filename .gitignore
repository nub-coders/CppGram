Makefile
compile_commands.json
CTestTestfile.cmake

# Secrets & Environment Variables
.env
.env.*
*.key
*.pem
*.token

# Telegram / TDLib / Database State & Logs
*.db
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
td.binlog
tdlib_log.txt
tdlib/

# Editor & IDE Configs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.vs/
*.user
*.suo

# Local AI Customizations & Rules
.agents/
AGENTS.md
GEMINI.md

# Logs & Temporary Files
*.log
*.tmp
